{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs",
    "build:hostinger": "rm -rf dist-hostinger && BASE_PATH=/ OUT_DIR=dist-hostinger vite build && BASE_PATH=/ OUT_DIR=dist-hostinger node scripts/prerender.mjs",
    "package:hostinger": "cd dist-hostinger && zip -rq ../thermalengitech-hostinger.zip . && cd .. && unzip -l thermalengitech-hostinger.zip",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-hostinger thermalengitech-hostinger.zip",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
